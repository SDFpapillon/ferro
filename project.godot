; Engine configuration file.
config_version=5

[application]

config/name="Ferro"
config/description="Jeu d'automatisation et de défense de base sur carte infinie"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

Constants="*res://scripts/autoload/Constants.gd"
Globals="*res://scripts/autoload/Globals.gd"
WorldGen="*res://scripts/autoload/WorldGen.gd"
GameManager="*res://scripts/autoload/GameManager.gd"
BuildingGrid="*res://scripts/autoload/BuildingGrid.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor_landscape"

